---
import { t, type Lang } from '../../i18n/ui';
import { companyMasks, getAllCompanies } from '../../lib/collections';
import { sortCompanies } from '../../lib/companies';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

// O logo é uma máscara (npm run assets) pintada com a cor do texto, então serve nos dois temas.
const companies = sortCompanies(await getAllCompanies()).map((company) => ({
  name: company.data.name,
  url: company.data.url,
  mask: companyMasks.get(company.id)!.src,
}));
---

<section class="proof" aria-labelledby="proof-title">
  <div class="container">
    <p id="proof-title" class="mono title">{t(lang, 'proof.logos')}</p>
    <ul>
      {
        companies.map(({ name, url, mask }) => (
          <li>
            <a class="tile" href={url} target="_blank" rel="noopener" aria-label={name} title={name}>
              <span class="logo" aria-hidden="true" style={`--logo: url(${mask})`} />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .proof {
    padding-block: var(--space-48);
    background: var(--surface);
    border-bottom: var(--border-width) solid var(--border);
  }

  .title {
    margin-bottom: var(--space-24);
    color: var(--text-muted);
    font-size: var(--fs-10);
    text-align: center;
  }

  /* Os quadrados têm o tamanho de --logo-tile e a lista quebra sozinha conforme a largura da tela.
     A última linha, incompleta, fica centralizada. No celular, um quadro por linha. */
  ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-24);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    flex: 0 0 var(--logo-tile);
  }

  /* Quadrado com o logo em cinza; no hover (ou foco) só a borda ganha o destaque. */
  .tile {
    display: grid;
    grid-template: minmax(0, 1fr) / minmax(0, 1fr);
    place-items: center;
    width: 100%;
    aspect-ratio: 1;
    padding: var(--space-24);
    color: var(--text-muted);
    background: var(--bg);
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-m);
    transition: border-color var(--duration-fast);
  }

  .logo {
    grid-area: 1 / 1;
    width: 100%;
    height: 100%;
    background: currentColor;
    mask: var(--logo) center / contain no-repeat;
  }

  .tile:hover,
  .tile:focus-visible {
    border-color: var(--accent);
  }

  @media (max-width: 767px) {
    ul {
      gap: var(--space-16);
    }

    li {
      flex: 0 0 100%;
      max-width: 420px;
    }

    .tile {
      aspect-ratio: auto;
      height: 128px;
    }
  }
</style>
