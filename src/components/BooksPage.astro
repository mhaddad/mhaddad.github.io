---
import { Image } from 'astro:assets';
import ArticleCard from './ArticleCard.astro';
import Boxes from './Boxes.astro';
import Icon from './Icon.astro';
import TalkList from './TalkList.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { routePath } from '../i18n/routes';
import { otherLang, t, type Lang } from '../i18n/ui';
import { getAllArticles, getAllTalks, getBooks } from '../lib/collections';
import { relatedArticlesFor } from '../lib/services';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const [book] = await getBooks(lang);
const { title, subtitle, description, cover, coverAlt, buyUrl, siteUrl, about, audience, contents, relatedTalks } = book.data;
const [articles, talks] = await Promise.all([getAllArticles(), getAllTalks()]);
const relatedArticles = relatedArticlesFor(book, articles);
const relatedMedia = relatedTalks.flatMap((id) => talks.filter((talk) => talk.id === id));
---

<BaseLayout lang={lang} title={t(lang, 'books.pageTitle')} description={description} alternatePath={routePath('books', otherLang(lang))}>
  <div class="container book-grid">
    <div class="content">
      <header class="book-header">
        <p class="label mono">{t(lang, 'books.label')}</p>
        <h1>{title}</h1>
        <p class="subtitle">{subtitle}</p>
        <div class="actions">
          <a class="button button--primary button--large" href={buyUrl} target="_blank" rel="noopener">
            {t(lang, 'books.buy')}
          </a>
          <a class="button button--secondary button--large" href={siteUrl} target="_blank" rel="noopener">
            {t(lang, 'books.site')}
            <Icon name="arrow-right" size="s" />
          </a>
        </div>
      </header>

      <section aria-labelledby="about-heading">
        <h2 id="about-heading" class="section-title mono">{t(lang, 'books.about')}</h2>
        {about.map((paragraph) => <p class="paragraph">{paragraph}</p>)}
      </section>

      <section aria-labelledby="audience-heading">
        <h2 id="audience-heading" class="section-title mono">{t(lang, 'books.audience')}</h2>
        <ul class="audience">
          {
            audience.map((item) => (
              <li>
                <span class="mark">
                  <Icon name="check" size="s" />
                </span>
                {item}
              </li>
            ))
          }
        </ul>
      </section>

      <section aria-labelledby="contents-heading">
        <h2 id="contents-heading" class="section-title mono">{t(lang, 'books.contents')}</h2>
        <Boxes class="contents" items={contents} columns={2} />
      </section>

      {
        (relatedArticles.length > 0 || relatedMedia.length > 0) && (
          <section aria-labelledby="related-heading" class="related-section">
            <h2 id="related-heading" class="section-title mono">
              {t(lang, 'books.related')}
            </h2>
            <div class="related">
              {relatedArticles.length > 0 && (
                <div class="related-articles">
                  {relatedArticles.map((article) => (
                    <ArticleCard article={article} />
                  ))}
                </div>
              )}
              {relatedMedia.length > 0 && <TalkList talks={relatedMedia} lang={lang} />}
            </div>
          </section>
        )
      }
    </div>

    <aside class="sidebar">
      <Image src={cover} alt={coverAlt} widths={[400, 800]} sizes="(max-width: 1023px) 100vw, 400px" loading="eager" />
    </aside>
  </div>
</BaseLayout>

<style>
  .book-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) var(--width-aside);
    gap: var(--space-80);
    align-items: start;
  }

  .content {
    display: flex;
    flex-direction: column;
    gap: var(--space-48);
    padding-top: var(--space-64);
  }

  .book-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
    margin-top: calc(-1 * var(--space-16));
  }

  .label {
    color: var(--accent);
  }

  h1 {
    font-size: var(--fs-44);
    line-height: var(--lh-heading);
  }

  .subtitle {
    color: var(--text-muted);
    font-size: var(--fs-18);
    line-height: var(--lh-snug);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-12);
    margin-top: var(--space-8);
  }

  .section-title {
    margin-bottom: var(--space-16);
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: var(--fs-11);
    font-weight: 500;
  }

  .paragraph {
    margin-bottom: var(--space-16);
    font-size: var(--fs-17);
    line-height: var(--lh-body);
  }

  .paragraph:last-child {
    margin-bottom: 0;
  }

  .audience {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .audience li {
    display: flex;
    gap: var(--space-12);
    color: var(--text-muted);
    font-size: var(--fs-16);
    line-height: var(--lh-body);
  }

  .mark {
    flex-shrink: 0;
    padding-top: var(--space-4);
    color: var(--accent);
  }

  /* Traço que separa as mídias e os artigos relacionados do restante da página. */
  .related-section {
    padding-top: var(--space-48);
    border-top: var(--border-width) solid var(--border);
  }

  .related {
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
  }

  .related-articles {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(var(--width-portrait-tablet), 1fr));
    gap: var(--space-24);
  }

  /* A capa fica parada no topo, ao lado do cabeçalho; não acompanha a rolagem. */
  .sidebar {
    padding-top: var(--space-64);
  }

  .sidebar :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (max-width: 1023px) {
    .book-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }

    /* Em telas estreitas a capa vem primeiro, antes do texto. */
    .sidebar {
      order: -1;
      width: 100%;
      max-width: var(--width-portrait-tablet);
      margin-inline: auto;
      padding-top: var(--space-40);
    }

    .content {
      padding-top: var(--space-32);
    }
  }

  @media (max-width: 767px) {
    .content {
      gap: var(--space-40);
    }

    h1 {
      font-size: var(--fs-32);
    }
  }
</style>
